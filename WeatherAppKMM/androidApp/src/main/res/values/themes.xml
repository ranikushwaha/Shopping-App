<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WeatherApp" parent="Theme.Material3.DayNight">
        <!-- Splash screen (API 31+) -->
        <item name="android:windowSplashScreenBackground">@color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/purple_200</item>

        <!-- Background and transparency fixes -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
