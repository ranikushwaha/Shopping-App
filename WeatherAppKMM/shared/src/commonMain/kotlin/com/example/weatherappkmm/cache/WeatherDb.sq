CREATE TABLE weather (
    id INTEGER PRIMARY KEY,
    temperature REAL,
    windspeed REAL,
    winddirection REAL,
    weathercode INTEGER,
    time TEXT
);

selectLast:
SELECT * FROM weather ORDER BY id DESC LIMIT 1;

deleteAll:
DELETE FROM weather;

insertWeather:
INSERT INTO weather(temperature, windspeed, winddirection, weathercode, time)
VALUES (?, ?, ?, ?, ?);


